{
  "name": "sefiplan-nomina",
  "version": "0.1.0",
  "description": "Conciliación y totales de retenciones de nómina SEFIPLAN",
  "author": "Secretaría de Finanzas y Planeación",
  "main": "dist/main/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173 --strictPort\" \"tsc -p tsconfig.main.json --watch\" \"esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs --watch\" \"wait-on tcp:5173 file:dist/main/main.js file:dist/preload/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.main.json && npm run build:preload",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "test:integration": "electron scripts/integration-pipeline.mjs",
    "test:integration:auth": "node scripts/run-auth-integration.mjs",
    "test:e2e:auth": "node scripts/e2e-auth.mjs",
    "test:e2e:selection": "node scripts/e2e-file-selection.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "benchmark:fixture": "node scripts/generate-benchmark-file.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.2.0",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "exceljs": "^4.4.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "sass": "^1.90.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.4",
    "wait-on": "^8.0.4"
  },
  "overrides": { "uuid": "11.1.1" },
  "build": {
    "appId": "mx.gob.qroo.sefiplan.nomina",
    "productName": "SEFIPLAN Nómina",
    "asar": true,
    "files": ["dist/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
